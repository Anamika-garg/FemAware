NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cyclesense
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

# Set to true if you do not have MongoDB installed (development only).
# The API will start an ephemeral in-memory database preloaded with demo data.
USE_MEMORY_DB=false
