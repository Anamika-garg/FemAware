# Copy to server/.env and fill in your values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Use the `femaware` database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/femaware?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

# Set to true to skip Atlas and run an ephemeral in-memory database preloaded
# with the demo accounts (development only; data is lost on restart).
USE_MEMORY_DB=false

# Serve teen lessons and guidance that are still awaiting clinician review?
# Defaults to true outside production and false in production.
# ALLOW_UNREVIEWED_GUIDANCE=false

# Gemini-powered health guide. Create a key at https://aistudio.google.com/apikey
# and keep it server-side only. The chat endpoint returns a clear setup message
# until this is filled in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hidden reasoning budget for models that support thinking (2.5 and 3.x).
# Set to 0 to disable thinking.
GEMINI_THINKING_BUDGET=1024
